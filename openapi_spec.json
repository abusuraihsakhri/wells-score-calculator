{
  "openapi": "3.1.0",
  "info": {
    "title": "Wells Score Calculator API",
    "description": "Clinical score endpoints alongside separate experimental audit demonstration endpoints. See /openapi.json on a running FastAPI server for the canonical live schema.",
    "version": "3.0.0-ENTERPRISE"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Health report"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Demonstration counters",
        "responses": {
          "200": {
            "description": "Demo metrics object"
          }
        }
      }
    },
    "/api/score/criteria": {
      "get": {
        "summary": "List Wells DVT, Wells PE, and Revised Geneva criteria",
        "responses": {
          "200": {
            "description": "Criterion definitions"
          }
        }
      }
    },
    "/api/score/{score_type}": {
      "post": {
        "summary": "Evaluate a clinical score without storing the input",
        "parameters": [
          {
            "in": "path",
            "name": "score_type",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "dvt",
                "pe",
                "geneva"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                },
                "example": {
                  "active_cancer": true,
                  "previous_dvt": true
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scoring result with criteria and tier interpretations"
          },
          "404": {
            "description": "Unknown scoring rule"
          },
          "422": {
            "description": "Invalid criterion or mutually exclusive clinical inputs"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy generic audit demonstration (not a medical triage endpoint)",
        "responses": {
          "200": {
            "description": "Demonstration dossier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Legacy mock chat demonstration (no clinical model inference)",
        "responses": {
          "200": {
            "description": "Mock provider response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Legacy audit log records and signature status",
        "responses": {
          "200": {
            "description": "Demonstration audit trail"
          }
        }
      }
    }
  }
}
